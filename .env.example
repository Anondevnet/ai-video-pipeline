# Copy to your environment or export directly. Never commit real values.
# Preferred: JWT auth via AccessKey + SecretKey from the Kling dev console.
# KLING_ACCESS_KEY=...
# KLING_SECRET_KEY=...
# Alternative: a pre-generated API key/JWT used directly as Bearer token.
# KLING_API_KEY=...
# KLING_BASE_URL=https://api-singapore.klingai.com
# Set to 1 ONLY for local dry-runs; mock clips are clearly labeled.
# KLING_MOCK=0
# Explicit opt-in for paid live generation.
# KLING_LIVE_AUTHORIZED=0
